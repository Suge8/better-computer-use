{
	"name": "better-computer-use",
	"version": "0.1.0",
	"description": "CLI that lets AI agents observe and control macOS apps.",
	"type": "module",
	"keywords": [
		"computer-use",
		"cli",
		"agent-skills",
		"macos",
		"desktop-automation",
		"accessibility"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sugeh/better-computer-use.git"
	},
	"bugs": {
		"url": "https://github.com/sugeh/better-computer-use/issues"
	},
	"homepage": "https://github.com/sugeh/better-computer-use#readme",
	"engines": {
		"node": ">=20.6.0"
	},
	"files": [
		"dist",
		"src",
		"prebuilt/macos",
		"assets/reference/img.jpg",
		"README.md",
		"LICENSE",
		"docs"
	],
	"bin": {
		"bcu": "dist/bcu.mjs"
	},
	"scripts": {
		"prepare": "npm run build",
		"build": "esbuild src/cli.ts --bundle --platform=node --format=esm --banner:js=\"#!/usr/bin/env node\" --outfile=dist/bcu.mjs && esbuild scripts/setup-helper.mjs --bundle --platform=node --format=esm --outfile=dist/setup-helper.mjs",
		"build:native": "node scripts/build-native.mjs",
		"typecheck": "tsc -p tsconfig.json",
		"test:projection": "node scripts/check-projection.mjs",
		"test:contract": "node scripts/check-contract.mjs",
		"test:cli-errors": "node scripts/check-cli-errors.mjs",
		"test:runtime": "node scripts/check-runtime.mjs",
		"test:artifacts": "node scripts/check-artifacts.mjs",
		"test:broker": "node scripts/check-broker-lifecycle.mjs",
		"test:helper-transport": "node scripts/check-macos-helper-transport.mjs",
		"test:event-readiness": "node scripts/check-event-readiness.mjs",
		"test:helper-install": "node scripts/check-helper-install.mjs",
		"test:package": "node scripts/check-package.mjs",
		"test:native": "node scripts/check-native.mjs",
		"test:helper-live": "node scripts/check-helper-live.mjs",
		"test:smoke": "node scripts/check-e2e-smoke.mjs && node scripts/check-transient-roots.mjs && node scripts/check-helper-live.mjs",
		"test": "npm run typecheck && npm run test:projection && npm run test:contract && npm run test:cli-errors && npm run test:runtime && npm run test:artifacts && npm run test:broker && npm run test:helper-transport && npm run test:event-readiness && npm run test:helper-install && npm run test:package && npm run test:native"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"esbuild": "^0.28.1",
		"typescript": "^6.0.3"
	}
}
