{
	"name": "better-computer-use",
	"version": "0.1.0",
	"description": "CLI that lets AI agents observe and control macOS, Windows, and Linux apps.",
	"type": "module",
	"keywords": [
		"computer-use",
		"cli",
		"agent-skills",
		"macos",
		"windows",
		"desktop-automation",
		"accessibility",
		"linux"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sugeh/better-computer-use.git"
	},
	"bugs": {
		"url": "https://github.com/sugeh/better-computer-use/issues"
	},
	"homepage": "https://github.com/sugeh/better-computer-use#readme",
	"engines": {
		"node": ">=20.6.0"
	},
	"files": [
		"dist",
		"src",
		"scripts/build-native.mjs",
		"scripts/setup-helper.mjs",
		"native/macos/bridge.swift",
		"native/windows/bridge-rs/Cargo.lock",
		"native/windows/bridge-rs/Cargo.toml",
		"native/windows/bridge-rs/src",
		"native/windows/bridge-rs/tests",
		"prebuilt/macos",
		"prebuilt/windows",
		"assets/reference/img.jpg",
		"README.md",
		"LICENSE",
		"native/linux/bridge-rs",
		"prebuilt/linux",
		"docs"
	],
	"bin": {
		"bcu": "dist/bcu.mjs"
	},
	"scripts": {
		"postinstall": "node scripts/setup-helper.mjs --postinstall",
		"build": "esbuild src/cli.ts --bundle --platform=node --format=esm --banner:js=\"#!/usr/bin/env node\" --outfile=dist/bcu.mjs",
		"typecheck": "tsc -p tsconfig.json",
		"test:schema": "node scripts/check-tool-schemas.mjs",
		"test:bundle": "node scripts/check-bundled-runtime.mjs",
		"test:artifacts": "node scripts/check-artifacts.mjs",
		"test:cli-errors": "node scripts/check-cli-errors.mjs",
		"test:package": "node scripts/check-package.mjs",
		"test:invariants": "node scripts/check-invariants.mjs",
		"test:lifecycle": "node scripts/check-session-lifecycle.mjs",
		"test:runtime": "node scripts/check-runtime-concurrency.mjs",
		"test:broker": "node scripts/check-broker-lifecycle.mjs",
		"test:helper-transport": "node scripts/check-macos-helper-transport.mjs",
		"test:event-readiness": "node scripts/check-event-readiness.mjs",
		"test:cubench-adapter": "node scripts/check-cubench-agent-broker.mjs",
		"test:commits": "node scripts/check-commit-messages.mjs",
		"test:platform": "node scripts/check-platform-windows.mjs",
		"test:windows-scripts": "node scripts/check-windows-build-scripts.mjs",
		"test:signing": "node scripts/check-local-signing.mjs",
		"test:macos-path": "node scripts/check-macos-helper-path.mjs",
		"test:smoke": "node scripts/check-e2e-smoke.mjs && node scripts/check-browser-errors.mjs",
		"test": "npm run typecheck && npm run test:schema && npm run test:bundle && npm run test:artifacts && npm run test:cli-errors && npm run test:package && npm run test:lifecycle && npm run test:runtime && npm run test:broker && npm run test:helper-transport && npm run test:event-readiness && npm run test:cubench-adapter && npm run test:platform && npm run test:invariants && npm run test:signing && npm run test:macos-path",
		"build:native": "node scripts/build-native.mjs",
		"build:windows": "node scripts/build-native.mjs --platform windows",
		"build:linux": "node scripts/build-native.mjs --platform linux",
		"test:linux": "node scripts/check-platform-linux.mjs",
		"test:linux-scripts": "node scripts/check-linux-build-scripts.mjs",
		"test:linux-live": "BCU_LIVE=1 node scripts/check-linux-live.mjs"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"esbuild": "^0.28.1",
		"typescript": "^6.0.3"
	}
}
